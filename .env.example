# ── Cloudflare (실제로 쓰는 온라인 백엔드) ──
# worker/ 를 배포하면 나오는 *.workers.dev (또는 커스텀 도메인) URL.
# 이 파일을 .env.local 로 복사하고 값을 채우면 온라인 대전 버튼이 켜진다.
# 값이 비어 있으면 앱은 AI 연습 전용 오프라인 모드로만 동작한다 (src/backend/config.ts).
VITE_WORKER_URL=

# ── Firebase (레거시, 미사용) ──
# 이전에 검토했던 백엔드. src/backend/firebase/* 코드는 남아있지만 store.ts 는
# 더 이상 이 값을 참조하지 않는다 — Cloudflare 로 교체됐다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
