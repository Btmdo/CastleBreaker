# Firebase 웹 앱 설정 — Firebase 콘솔의 프로젝트 설정 > 일반 > 내 앱에서 복사한다.
# 이 파일을 .env.local 로 복사하고 값을 채우면 온라인 기능이 자동으로 켜진다.
# 값이 비어 있으면 앱은 AI 연습 전용 오프라인 모드로만 동작한다 (src/backend/config.ts).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
